# ---- ResQGrid web app ----
# AI service (Flask). Leave as-is when running locally.
ML_SERVICE_URL=http://127.0.0.1:5000

# Code authorities type on /login to open the Command Center. CHANGE THIS.
AUTHORITY_CODE=resq2026
# Random string used to sign the login cookie. CHANGE THIS.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: protects /api/refresh when called by a cron job
CRON_SECRET=

# ---- Supabase (optional) ----
# Leave these empty to run in LOCAL mode (data saved in web/.data/db.json).
# Fill them to store everything in Supabase (Postgres + PostGIS + Storage + Realtime).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
